rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerOf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwnerOf(userId);
    }

    // Turfs & Verification
    match /turfs/{turfId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();

      // Verification Documents subcollection (Private to owner and admins)
      match /verificationDocuments/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Verification History subcollection (Audit log)
      match /verificationHistory/{historyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false; // immutable audit history
      }
    }

    // Arenas
    match /arenas/{arenaId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Slots
    match /slots/{slotId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Booking Players & Booking Shares
    match /bookingPlayers/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /bookingShares/{shareId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Payments & Payment Transactions
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /paymentTransactions/{txId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Lobbies & Lobby Players & Invitations
    match /lobbies/{lobbyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /lobbyPlayers/{playerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /lobbyInvitations/{invitationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Teams, Members & Team Invitations
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /teamMembers/{memberId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /teamInvitations/{invitationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Matches & Match Players
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /matchPlayers/{matchPlayerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Reviews (turfReviews and reviews)
    match /turfReviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Offers & Promos
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rewards & Wallets
    match /userRewardWallets/{walletId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /rewardWallets/{walletId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /rewardHistory/{historyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /rewardVouchers/{voucherId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Notifications
    match /inAppNotifications/{notifId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Recurring Schedules
    match /recurringSchedules/{scheduleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Player Dues & Dues
    match /dues/{dueId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /playerDues/{dueId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Player Pools / Interest Pools
    match /playerPools/{poolId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /pools/{poolId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Refunds
    match /refunds/{refundId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

