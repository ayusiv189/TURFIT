rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can access any storage files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Direct Conversation Media access rules
    match /conversations/{conversationId}/{fileName} {
      // Allow read and write if the user is authenticated and is a participant in the conversation
      allow read, write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/direct_conversations/$(conversationId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/direct_conversations/$(conversationId)).data.participants;
    }
  }
}
